# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/fairy_tales
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fairy_tales
MONGODB_URI=mongodb://127.0.0.1:27017/fairy_tales

# Long, random secret used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session/token lasts
JWT_EXPIRES_IN=7d

# Port the server listens on
PORT=3000

# "production" enables secure (HTTPS-only) cookies
NODE_ENV=development
